rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function meuUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && meuUsuario().perfil == 'administrador';
    }

    function isCoordenador() {
      return isSignedIn() && meuUsuario().perfil == 'coordenador';
    }

    function isFinanceiro() {
      return isSignedIn() && meuUsuario().perfil == 'financeiro';
    }

    // Usuário da NG (qualquer perfil, menos o responsável da parceira, que só enxerga o fechamento da própria empresa).
    function isInterno() {
      return isSignedIn() && meuUsuario().perfil != 'responsavel_parceira';
    }

    function meuRecursoId() {
      // .get() com padrão evita erro em documentos antigos sem o campo
      // recursoId (acessar direto por ".recursoId" derruba a regra inteira
      // quando o campo não existe).
      return meuUsuario().get('recursoId', null);
    }

    // Marcador antigo do "admin seed" (não é mais usado pelo app). Só o administrador enxerga.
    match /config/bootstrap {
      allow read, write: if isAdmin();
    }

    match /usuarios/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      // Sem autocadastro: só um admin cria usuários (via rota server-side com Admin SDK, que já ignora
      // estas regras — isso aqui é reforço). O primeiro admin de uma instalação nova é criado pelo
      // script scripts/criar-primeiro-admin.mjs, também com o Admin SDK.
      allow create, update, delete: if isAdmin();
    }

    match /clientes/{id} {
      allow read: if isInterno();
      allow write: if isAdmin();
    }

    // O valor/hora fica em recursosValores (só admin e financeiro): não pode voltar a ser gravado aqui.
    match /recursos/{id} {
      allow read: if isInterno();
      allow create, update: if isAdmin() && !request.resource.data.keys().hasAny(['valorHora']);
      allow delete: if isAdmin();
    }

    match /parceiras/{id} {
      allow read: if isInterno();
      allow write: if isAdmin();
    }

    match /tiposDocumento/{id} {
      allow read: if isInterno();
      allow write: if isAdmin();
    }

    match /escopos/{id} {
      allow read: if isInterno();
      allow write: if isAdmin();
    }

    // Auditoria de cada importação de escopo (2.1): quem importou, o arquivo e quantas linhas
    // precisaram de correção de duração. Só é criada pela própria tela de importação — nunca
    // editada ou apagada depois.
    match /escoposImportados/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.usuarioId == request.auth.uid;
      allow update, delete: if false;
    }

    // Espelho enxuto de "usuarios" (nome, perfil, recurso) que todo usuário logado
    // lê — alimenta a lista de @ da linha do tempo, já que "usuarios" só é listável
    // por administradores. Cada pessoa mantém a própria entrada (sem poder mudar o
    // perfil dela); o administrador mantém todas.
    match /diretorio/{uid} {
      allow read: if isInterno();
      allow create, update: if isAdmin() ||
        (isSignedIn() && request.auth.uid == uid &&
          request.resource.data.perfil == meuUsuario().get('perfil', ''));
      allow delete: if isAdmin();
    }

    // Avisos de quem foi marcado (@) na linha do tempo dos projetos. Só o
    // destinatário lê, marca como lida (único campo que pode mudar) ou apaga;
    // qualquer usuário logado cria, desde que se identifique como autor.
    match /notificacoes/{id} {
      allow read: if isSignedIn() && resource.data.destinatarioUid == request.auth.uid;
      // Só usuários da NG notificam, sempre no próprio nome (o nome vem do cadastro, não dá para se passar por outro),
      // com os campos que o sistema usa, texto curto e um projeto que exista.
      allow create: if isInterno() &&
        request.resource.data.autorUid == request.auth.uid &&
        request.resource.data.autorNome == meuUsuario().get('nomeCompleto', '') &&
        request.resource.data.lida == false &&
        request.resource.data.texto is string && request.resource.data.texto.size() <= 200 &&
        ((request.resource.data.keys().hasOnly(
            ['destinatarioUid', 'projetoId', 'projetoNome', 'contatoId', 'autorUid', 'autorNome', 'tipo', 'texto', 'criadoEm', 'lida']) &&
          exists(/databases/$(database)/documents/projetos/$(request.resource.data.projetoId))) ||
        // Aviso de tarefa compartilhada do Workspace: quem avisa e quem recebe precisam ser dono ou participante dela.
        (request.resource.data.keys().hasOnly(
            ['destinatarioUid', 'anotacaoId', 'projetoId', 'projetoNome', 'contatoId', 'autorUid', 'autorNome', 'tipo', 'texto', 'criadoEm', 'lida', 'origem']) &&
          request.resource.data.origem == 'workspace' &&
          souDonoOuParticipante(get(/databases/$(database)/documents/anotacoes/$(request.resource.data.anotacaoId)).data) &&
          (get(/databases/$(database)/documents/anotacoes/$(request.resource.data.anotacaoId)).data.usuarioId == request.resource.data.destinatarioUid ||
            request.resource.data.destinatarioUid in get(/databases/$(database)/documents/anotacoes/$(request.resource.data.anotacaoId)).data.get('participantesUids', []))));
      allow update: if isSignedIn() &&
        resource.data.destinatarioUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lida']);
      allow delete: if isSignedIn() && resource.data.destinatarioUid == request.auth.uid;
    }

    // Financeiro e contato de faturamento ficam em projetosFinanceiro (só admin e financeiro): não podem voltar a
    // ser gravados no projeto, que todo usuário da NG lê.
    function semDadosProtegidos() {
      return !request.resource.data.keys().hasAny(['financeiro', 'contatoFaturamento']);
    }

    match /projetos/{projetoId} {
      allow read: if isInterno();
      allow create: if (isAdmin() || isCoordenador()) && semDadosProtegidos();
      allow delete: if isAdmin() || isCoordenador();
      // Update normal é só admin/coordenador; um consultor alocado no projeto
      // pode atualizar exclusivamente o campo ultimoContato (registrar contato).
      allow update: if semDadosProtegidos() && (isAdmin() || isCoordenador() ||
        (isSignedIn() &&
          meuRecursoId() in resource.data.consultorIds &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimoContato'])) ||
        // O consultor alocado (em projeto não finalizado) também atualiza o cronograma (importar uma
        // nova versão troca só os campos do escopo/cronograma) e os principais envolvidos (key users).
        (isSignedIn() &&
          meuRecursoId() in resource.data.consultorIds &&
          resource.data.get('status', 'ativo') != 'finalizado' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['escopoId', 'escopoNome', 'escopoAtividades', 'escopoExclusoes', 'cronogramaVersao', 'principaisEnvolvidos', 'updatedAt'])));

      // Contato pode ser registrado por admin/coordenador, ou pelo consultor
      // alocado naquele projeto (mas nunca editado/apagado depois).
      match /contatos/{contatoId} {
        allow read: if isInterno();
        // Cada registro fica no nome de quem está logado (não dá para escrever na linha do tempo como outra pessoa).
        allow create: if request.resource.data.usuarioId == request.auth.uid &&
          request.resource.data.usuarioNome == meuUsuario().get('nomeCompleto', '') &&
          (isAdmin() || isCoordenador() ||
            (isSignedIn() &&
              meuRecursoId() in get(/databases/$(database)/documents/projetos/$(projetoId)).data.consultorIds));
        allow update, delete: if false;
      }

      // Histórico de versões do cronograma: cada importação grava uma foto completa + a
      // observação de quem importou. Admin/coordenador e o consultor alocado criam, todos leem, ninguém edita/apaga.
      match /versoesCronograma/{versaoId} {
        allow read: if isInterno();
        allow create: if isAdmin() || isCoordenador() ||
          (isSignedIn() &&
            request.resource.data.usuarioId == request.auth.uid &&
            meuRecursoId() in get(/databases/$(database)/documents/projetos/$(projetoId)).data.consultorIds &&
            get(/databases/$(database)/documents/projetos/$(projetoId)).data.get('status', 'ativo') != 'finalizado');
        allow update, delete: if false;
      }
    }

    // Dados sensíveis que saíram dos documentos que todo usuário logado lê (as regras liberam o documento inteiro,
    // nunca um campo só): financeiro e contato de faturamento do projeto, e valor/hora do recurso.
    // Só administrador e financeiro leem. O coordenador pode apagar o do projeto que ele exclui.
    match /projetosFinanceiro/{projetoId} {
      allow read, create, update: if isAdmin() || isFinanceiro();
      allow delete: if isAdmin() || isFinanceiro() || isCoordenador();
    }

    match /recursosValores/{recursoId} {
      allow read: if isAdmin() || isFinanceiro();
      allow write: if isAdmin();
    }

    // Fechamento mensal de horas (só administrador e financeiro): um documento por mês ("YYYY-MM"),
    // com a auditoria de cada mudança de status em "historico" (só criada, nunca editada/apagada).
    match /fechamentos/{mesAno} {
      allow read, create, update: if isAdmin() || isFinanceiro();
      allow delete: if false;

      match /historico/{historicoId} {
        allow read: if isAdmin() || isFinanceiro();
        allow create: if (isAdmin() || isFinanceiro()) && request.resource.data.usuarioId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // O que cada consultor tem a receber no mês (detalhe dos lançamentos). Administrador e financeiro: tudo.
    // O consultor terceiro lê SÓ o próprio item, depois de liberado para ele (já no envio para revisão), e só grava a confirmação/contestação dele.
    match /fechamentoItens/{itemId} {
      allow read: if isAdmin() || isFinanceiro() ||
        (isSignedIn() && meuRecursoId() != null && resource.data.recursoId == meuRecursoId() && resource.data.liberado == true);
      allow create, delete: if isAdmin() || isFinanceiro();
      allow update: if isAdmin() || isFinanceiro() ||
        (isSignedIn() && meuRecursoId() != null && resource.data.recursoId == meuRecursoId() && resource.data.liberado == true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmacao']) &&
          request.resource.data.confirmacao.status in ['confirmado', 'contestado']);
    }

    // Quem envia a NF da parceira: o contato 1 do cadastro dela, reconhecido pelo e-mail do login
    // (o consultor terceiro faz isso pelo "Meu fechamento").
    function souResponsavelNfDa(parceiraId) {
      return isSignedIn() && parceiraId != null && request.auth.token.email != null &&
        get(/databases/$(database)/documents/parceiras/$(parceiraId)).data.get('contatos', []).size() > 0 &&
        get(/databases/$(database)/documents/parceiras/$(parceiraId)).data.contatos[0].get('email', '').lower() ==
          request.auth.token.email.lower();
    }

    // Confirmação da parceira: vale a de cada consultor (statusConsultores) ou, em documentos antigos, a do responsável.
    function consultoresConfirmaram(d) {
      return d.get('statusConsultores', null) != null
        ? d.statusConsultores.values().hasOnly(['confirmado'])
        : d.confirmacao.status == 'confirmado';
    }

    // Fechamento de cada empresa parceira no mês. Administrador/financeiro gerenciam tudo (inclusive validar
    // a nota fiscal e registrar pagamentos). O responsável da parceira (perfil "responsavel_parceira") só
    // enxerga o da própria empresa DEPOIS de liberado o faturamento e só pode: registrar a ciência e
    // confirmar/contestar (campos "ciencia" e "confirmacao") e, depois de confirmar, enviar a nota fiscal
    // (campos "nf" e "historicoNf"), enquanto ela não existir ou tiver sido rejeitada.
    match /fechamentoParceiros/{fpId} {
      allow read: if isAdmin() || isFinanceiro() ||
        (isSignedIn() && meuUsuario().perfil == 'responsavel_parceira' &&
          resource.data.parceiraId == meuUsuario().get('parceiraId', null) && resource.data.liberado == true) ||
        (resource.data.liberado == true && souResponsavelNfDa(resource.data.parceiraId));
      allow create, delete: if isAdmin() || isFinanceiro();
      allow update: if isAdmin() || isFinanceiro() ||
        // O contato 1 da parceira envia (ou reenvia, se rejeitada) a NF, depois que todos os consultores confirmaram.
        (resource.data.liberado == true && souResponsavelNfDa(resource.data.parceiraId) &&
          consultoresConfirmaram(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nf', 'historicoNf']) &&
          request.resource.data.nf.status == 'enviada' &&
          (resource.data.get('nf', null) == null || resource.data.nf.status == 'rejeitada')) ||
        // O consultor terceiro só troca a PRÓPRIA chave em statusConsultores, enquanto a NF não foi enviada — já na revisão
        // (fluxo novo: ele confere antes do fechamento) ou depois de liberado o faturamento (meses antigos).
        (isSignedIn() && meuRecursoId() != null &&
          (resource.data.liberado == true || resource.data.get('etapa', '') == 'em_revisao') &&
          resource.data.get('nf', null) == null &&
          resource.data.get('statusConsultores', null) != null && meuRecursoId() in resource.data.statusConsultores.keys() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statusConsultores']) &&
          request.resource.data.statusConsultores.diff(resource.data.statusConsultores).affectedKeys().hasOnly([meuRecursoId()]) &&
          request.resource.data.statusConsultores[meuRecursoId()] in ['confirmado', 'contestado']) ||
        (isSignedIn() && meuUsuario().perfil == 'responsavel_parceira' &&
          resource.data.parceiraId == meuUsuario().get('parceiraId', null) &&
          resource.data.liberado == true &&
          (
            (resource.data.confirmacao.status in ['pendente', 'contestado'] &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ciencia', 'confirmacao']) &&
              request.resource.data.confirmacao.status in ['pendente', 'confirmado', 'contestado'] &&
              (request.resource.data.confirmacao.status == 'pendente' || request.resource.data.ciencia.em != null))
            ||
            (consultoresConfirmaram(resource.data) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nf', 'historicoNf']) &&
              request.resource.data.nf.status == 'enviada' &&
              (resource.data.get('nf', null) == null || resource.data.nf.status == 'rejeitada'))
          ));
    }

    // Arquivos do fechamento (NF em PDF, comprovantes e documentos complementares), guardados no próprio Firestore em
    // partes de até ~700 KB (sem Firebase Storage). tipo: 'nf' | 'comprovante' | 'anexo'.
    // - administrador/financeiro: tudo;
    // - responsável da parceira (perfil) e o contato 1 da parceira: leem os arquivos da própria empresa e criam
    //   apenas a NF (PDF) dela.
    match /arquivosFechamento/{arquivoId} {
      allow read: if isAdmin() || isFinanceiro() ||
        (isSignedIn() && meuUsuario().perfil == 'responsavel_parceira' &&
          resource.data.parceiraId != null &&
          resource.data.parceiraId == meuUsuario().get('parceiraId', null)) ||
        souResponsavelNfDa(resource.data.parceiraId);
      allow create: if isAdmin() || isFinanceiro() ||
        (souResponsavelNfDa(request.resource.data.parceiraId) &&
          request.resource.data.tipo == 'nf' &&
          request.resource.data.tamanho <= 3145728) ||
        (isSignedIn() && meuUsuario().perfil == 'responsavel_parceira' &&
          request.resource.data.parceiraId != null &&
          request.resource.data.parceiraId == meuUsuario().get('parceiraId', null) &&
          request.resource.data.tipo == 'nf' &&
          request.resource.data.tamanho <= 3145728);
      allow update, delete: if isAdmin() || isFinanceiro();

      match /partes/{parteId} {
        allow read: if isAdmin() || isFinanceiro() ||
          (isSignedIn() && meuUsuario().perfil == 'responsavel_parceira' &&
            get(/databases/$(database)/documents/arquivosFechamento/$(arquivoId)).data.parceiraId != null &&
            get(/databases/$(database)/documents/arquivosFechamento/$(arquivoId)).data.parceiraId == meuUsuario().get('parceiraId', null)) ||
          souResponsavelNfDa(get(/databases/$(database)/documents/arquivosFechamento/$(arquivoId)).data.parceiraId);
        allow create: if isAdmin() || isFinanceiro() ||
          (souResponsavelNfDa(getAfter(/databases/$(database)/documents/arquivosFechamento/$(arquivoId)).data.parceiraId) &&
            getAfter(/databases/$(database)/documents/arquivosFechamento/$(arquivoId)).data.tipo == 'nf') ||
          (isSignedIn() && meuUsuario().perfil == 'responsavel_parceira' &&
            getAfter(/databases/$(database)/documents/arquivosFechamento/$(arquivoId)).data.parceiraId == meuUsuario().get('parceiraId', null) &&
            getAfter(/databases/$(database)/documents/arquivosFechamento/$(arquivoId)).data.tipo == 'nf');
        allow update, delete: if isAdmin() || isFinanceiro();
      }
    }

    // Calendário/apontamento unificados: cada consultor só enxerga e mexe nos
    // próprios eventos (onde recursoId é o recurso vinculado a ele); admin e
    // coordenador enxergam e gerenciam o calendário de todo mundo.
    // Apontamentos: o consultor lança e confirma as próprias horas, mas quem APROVA é o coordenador/admin.
    // Status que o consultor pode gravar (inclui os nomes antigos das recorrências).
    function statusDoConsultor(d) {
      return d.get('status', null) in ['previsto', 'aguardando_aprovacao', 'cancelado', 'pendente', 'cancelada'] ||
        (d.get('status', null) == null && d.get('origem', '') != 'avulso');
    }
    // Apontamento já aprovado (avulso antigo sem status também conta como aprovado no sistema).
    function apontamentoAprovado(d) {
      return d.get('status', null) in ['aprovado', 'realizada'] ||
        (d.get('status', null) == null && d.get('origem', '') == 'avulso');
    }
    // Recurso do tipo coordenador se aprova sozinho (regra de negócio do sistema).
    function meuRecursoEhCoordenador() {
      return meuRecursoId() != null &&
        get(/databases/$(database)/documents/recursos/$(meuRecursoId())).data.get('tipo', '') == 'coordenador';
    }
    function gravacaoDoConsultorPermitida(d) {
      return d.recursoId == meuRecursoId() &&
        d.get('retroativo', false) != true &&
        (statusDoConsultor(d) || meuRecursoEhCoordenador());
    }

    // Recurso inativado (ativo == false) só aceita apontamento até a data de inativação, inclusive. Vale para todos os
    // perfis. Sem data de inativação, o inativo não aceita nenhum.
    function recursoAceitaData(d) {
      return get(/databases/$(database)/documents/recursos/$(d.recursoId)).data.get('ativo', true) != false ||
        get(/databases/$(database)/documents/recursos/$(d.recursoId)).data.get('dataInativacao', '') >= d.data;
    }
    // Na edição, só confere quando a data ou o recurso mudam (ajustar um lançamento antigo continua liberado).
    function dataOuRecursoMudou() {
      return request.resource.data.data != resource.data.data || request.resource.data.recursoId != resource.data.recursoId;
    }

    match /eventosCalendario/{id} {
      // Além do próprio apontamento, um consultor também pode ler os apontamentos de outros
      // consultores DENTRO DE UM PROJETO em que ele esteja alocado — para ele enxergar o que já
      // foi feito no escopo e o percentual real do projeto, sem ver apontamentos de projetos
      // que não são dele. A visão de calendário pessoal continua restrita ao próprio recurso
      // porque a tela em si só busca os eventos do próprio consultor.
      allow read: if isAdmin() || isCoordenador() || isFinanceiro() ||
        (isSignedIn() && resource.data.recursoId == meuRecursoId()) ||
        (isSignedIn() &&
          meuRecursoId() in get(/databases/$(database)/documents/projetos/$(resource.data.projetoId)).data.get('consultorIds', []));
      // Consultor não pode criar apontamento em projeto com status "finalizado"
      // (admin/coordenador continuam podendo, mesmo com o projeto finalizado).
      // .get() com padrão 'ativo' evita erro em projetos antigos sem o campo status.
      // O consultor só cria com status de "lançado/aguardando" (nunca já aprovado ou retroativo).
      allow create: if isSignedIn() && recursoAceitaData(request.resource.data) && (isAdmin() || isCoordenador() ||
        (gravacaoDoConsultorPermitida(request.resource.data) &&
          get(/databases/$(database)/documents/projetos/$(request.resource.data.projetoId)).data.get('status', 'ativo') != 'finalizado'));
      // O consultor não mexe em apontamento já aprovado (nem para editar, nem para excluir) e não consegue se aprovar.
      allow update: if isSignedIn() && (!dataOuRecursoMudou() || recursoAceitaData(request.resource.data)) && (isAdmin() || isCoordenador() ||
        (resource.data.recursoId == meuRecursoId() &&
          (!apontamentoAprovado(resource.data) || meuRecursoEhCoordenador()) &&
          gravacaoDoConsultorPermitida(request.resource.data)));
      allow delete: if isAdmin() || isCoordenador() ||
        (isSignedIn() && resource.data.recursoId == meuRecursoId() &&
          (!apontamentoAprovado(resource.data) || meuRecursoEhCoordenador()));
    }

    // Workspace pessoal (Meu Workspace): anotações PRIVADAS de qualquer usuário da NG. Só o dono lê e grava — nem o
    // administrador, nem o coordenador, nem os colegas do projeto (vincular a um projeto não muda a visibilidade). Excluir
    // manda para a lixeira (deletedAt); só o que já está na lixeira pode ser apagado de vez (pelo dono, ou sozinho depois
    // de 15 dias). O histórico segue a mesma regra. O responsável da parceira (externo) não tem Workspace.
    function temWorkspace() {
      return isInterno();
    }
    // Tarefa compartilhada: o administrador e o financeiro podem marcar outras pessoas (participantes) numa anotação, para
    // se comunicarem por atividades. Consultor e coordenador nunca marcam ninguém. O participante lê, atualiza e comenta,
    // mas não muda o dono, os participantes nem manda para a lixeira (isso é só do dono).
    function podeCompartilhar() {
      return isAdmin() || isFinanceiro();
    }
    function souDonoOuParticipante(d) {
      return d.usuarioId == request.auth.uid || request.auth.uid in d.get('participantesUids', []);
    }
    function anotacaoValida(d) {
      return d.titulo is string && d.titulo.size() > 0 && d.titulo.size() <= 200 &&
        (d.get('participantesUids', []) is list && d.get('participantesUids', []).size() <= 10) &&
        d.status in ['a_fazer', 'em_andamento', 'concluido', 'arquivado'] &&
        d.prioridade in ['baixa', 'normal', 'alta'] &&
        (d.get('descricao', null) == null || (d.descricao is string && d.descricao.size() <= 5000)) &&
        (d.get('tags', []) is list && d.get('tags', []).size() <= 20) &&
        (d.get('lembreteDiasAntes', null) == null ||
          (d.lembreteDiasAntes is number && d.lembreteDiasAntes >= 0 && d.lembreteDiasAntes <= 60)) &&
        (d.get('lembretesDiasAntes', null) == null ||
          (d.lembretesDiasAntes is list && d.lembretesDiasAntes.size() <= 10));
    }
    match /anotacoes/{anotacaoId} {
      allow read: if temWorkspace() && souDonoOuParticipante(resource.data);
      allow create: if temWorkspace() && request.resource.data.usuarioId == request.auth.uid && anotacaoValida(request.resource.data) &&
        (request.resource.data.get('participantesUids', []).size() == 0 || podeCompartilhar());
      allow update: if temWorkspace() && anotacaoValida(request.resource.data) && (
        // Dono: tudo (marcar participantes só admin/financeiro).
        (resource.data.usuarioId == request.auth.uid && request.resource.data.usuarioId == request.auth.uid &&
          (request.resource.data.get('participantesUids', []) == resource.data.get('participantesUids', []) ||
            request.resource.data.get('participantesUids', []).size() == 0 || podeCompartilhar())) ||
        // Participante: atualiza a tarefa, sem mexer no dono, nos participantes nem na lixeira.
        (request.auth.uid in resource.data.get('participantesUids', []) &&
          request.resource.data.usuarioId == resource.data.usuarioId &&
          request.resource.data.get('participantesUids', []) == resource.data.get('participantesUids', []) &&
          request.resource.data.get('deletedAt', null) == resource.data.get('deletedAt', null)));
      allow delete: if temWorkspace() && resource.data.usuarioId == request.auth.uid && resource.data.get('deletedAt', null) != null;

      match /historico/{historicoId} {
        allow read: if temWorkspace() &&
          souDonoOuParticipante(get(/databases/$(database)/documents/anotacoes/$(anotacaoId)).data);
        allow create: if temWorkspace() && request.resource.data.usuarioId == request.auth.uid &&
          souDonoOuParticipante(getAfter(/databases/$(database)/documents/anotacoes/$(anotacaoId)).data);
        allow update: if false;
        allow delete: if temWorkspace() &&
          get(/databases/$(database)/documents/anotacoes/$(anotacaoId)).data.usuarioId == request.auth.uid &&
          get(/databases/$(database)/documents/anotacoes/$(anotacaoId)).data.get('deletedAt', null) != null;
      }

      // Conversa da tarefa compartilhada: dono e participantes registram atualizações (sempre no próprio nome).
      match /comentarios/{comentarioId} {
        allow read: if temWorkspace() &&
          souDonoOuParticipante(get(/databases/$(database)/documents/anotacoes/$(anotacaoId)).data);
        allow create: if temWorkspace() && request.resource.data.usuarioId == request.auth.uid &&
          request.resource.data.usuarioNome == meuUsuario().get('nomeCompleto', '') &&
          request.resource.data.texto is string && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 2000 &&
          souDonoOuParticipante(get(/databases/$(database)/documents/anotacoes/$(anotacaoId)).data);
        allow update: if false;
        allow delete: if temWorkspace() &&
          get(/databases/$(database)/documents/anotacoes/$(anotacaoId)).data.usuarioId == request.auth.uid &&
          get(/databases/$(database)/documents/anotacoes/$(anotacaoId)).data.get('deletedAt', null) != null;
      }
    }

    // Bloqueios de agenda (férias, curso...): nenhum apontamento pode cair dentro deles.
    // Administrador bloqueia a agenda de qualquer consultor; o consultor bloqueia só a própria
    // e só mexe nos bloqueios que ele mesmo criou (os do administrador ficam só para leitura).
    // Coordenador apenas enxerga (calendário e mapa de alocação).
    match /bloqueiosAgenda/{id} {
      allow read: if isAdmin() || isCoordenador() ||
        (isSignedIn() && resource.data.recursoId == meuRecursoId());
      allow create: if isAdmin() ||
        (isSignedIn() && meuRecursoId() != null &&
          request.resource.data.recursoId == meuRecursoId() &&
          request.resource.data.criadoPorUid == request.auth.uid);
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.recursoId == meuRecursoId() &&
          resource.data.criadoPorUid == request.auth.uid &&
          request.resource.data.recursoId == meuRecursoId() &&
          request.resource.data.criadoPorUid == request.auth.uid);
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.recursoId == meuRecursoId() &&
          resource.data.criadoPorUid == request.auth.uid);
    }
  }
}
