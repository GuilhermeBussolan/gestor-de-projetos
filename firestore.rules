rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function meuUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && meuUsuario().perfil == 'administrador';
    }

    function isCoordenador() {
      return isSignedIn() && meuUsuario().perfil == 'coordenador';
    }

    function isFinanceiro() {
      return isSignedIn() && meuUsuario().perfil == 'financeiro';
    }

    function meuRecursoId() {
      // .get() com padrão evita erro em documentos antigos sem o campo
      // recursoId (acessar direto por ".recursoId" derruba a regra inteira
      // quando o campo não existe).
      return meuUsuario().get('recursoId', null);
    }

    // Documento público que marca se o admin seed já foi criado.
    match /config/bootstrap {
      allow read: if true;
      allow write: if !exists(/databases/$(database)/documents/config/bootstrap) || isAdmin();
    }

    match /usuarios/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      // Sem autocadastro: só um admin cria usuários (via rota server-side com
      // Admin SDK, que já ignora estas regras — isso aqui é reforço). A única
      // exceção é o bootstrap do primeiro admin, antes de config/bootstrap existir.
      allow create: if isAdmin() ||
        (isSignedIn() && request.auth.uid == uid &&
          request.resource.data.perfil == 'administrador' &&
          !exists(/databases/$(database)/documents/config/bootstrap));
      allow update, delete: if isAdmin();
    }

    match /clientes/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /recursos/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /parceiras/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /tiposDocumento/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /escopos/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Auditoria de cada importação de escopo (2.1): quem importou, o arquivo e quantas linhas
    // precisaram de correção de duração. Só é criada pela própria tela de importação — nunca
    // editada ou apagada depois.
    match /escoposImportados/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.usuarioId == request.auth.uid;
      allow update, delete: if false;
    }

    // Espelho enxuto de "usuarios" (nome, perfil, recurso) que todo usuário logado
    // lê — alimenta a lista de @ da linha do tempo, já que "usuarios" só é listável
    // por administradores. Cada pessoa mantém a própria entrada (sem poder mudar o
    // perfil dela); o administrador mantém todas.
    match /diretorio/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() ||
        (isSignedIn() && request.auth.uid == uid &&
          request.resource.data.perfil == meuUsuario().get('perfil', ''));
      allow delete: if isAdmin();
    }

    // Avisos de quem foi marcado (@) na linha do tempo dos projetos. Só o
    // destinatário lê, marca como lida (único campo que pode mudar) ou apaga;
    // qualquer usuário logado cria, desde que se identifique como autor.
    match /notificacoes/{id} {
      allow read: if isSignedIn() && resource.data.destinatarioUid == request.auth.uid;
      allow create: if isSignedIn() &&
        request.resource.data.autorUid == request.auth.uid &&
        request.resource.data.lida == false;
      allow update: if isSignedIn() &&
        resource.data.destinatarioUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lida']);
      allow delete: if isSignedIn() && resource.data.destinatarioUid == request.auth.uid;
    }

    match /projetos/{projetoId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin() || isCoordenador();
      // Update normal é só admin/coordenador; um consultor alocado no projeto
      // pode atualizar exclusivamente o campo ultimoContato (registrar contato);
      // financeiro pode atualizar exclusivamente o campo financeiro (status de
      // faturamento das parcelas, na Liberação de Faturamento).
      allow update: if isAdmin() || isCoordenador() ||
        (isSignedIn() &&
          meuRecursoId() in resource.data.consultorIds &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimoContato'])) ||
        (isFinanceiro() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['financeiro'])) ||
        // O consultor alocado (em projeto não finalizado) também atualiza o cronograma (importar uma
        // nova versão troca só os campos do escopo/cronograma) e os principais envolvidos (key users).
        (isSignedIn() &&
          meuRecursoId() in resource.data.consultorIds &&
          resource.data.get('status', 'ativo') != 'finalizado' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['escopoId', 'escopoNome', 'escopoAtividades', 'escopoExclusoes', 'cronogramaVersao', 'principaisEnvolvidos', 'updatedAt']));

      // Contato pode ser registrado por admin/coordenador, ou pelo consultor
      // alocado naquele projeto (mas nunca editado/apagado depois).
      match /contatos/{contatoId} {
        allow read: if isSignedIn();
        allow create: if isAdmin() || isCoordenador() ||
          (isSignedIn() &&
            meuRecursoId() in get(/databases/$(database)/documents/projetos/$(projetoId)).data.consultorIds);
        allow update, delete: if false;
      }

      // Histórico de versões do cronograma: cada importação grava uma foto completa + a
      // observação de quem importou. Admin/coordenador e o consultor alocado criam, todos leem, ninguém edita/apaga.
      match /versoesCronograma/{versaoId} {
        allow read: if isSignedIn();
        allow create: if isAdmin() || isCoordenador() ||
          (isSignedIn() &&
            request.resource.data.usuarioId == request.auth.uid &&
            meuRecursoId() in get(/databases/$(database)/documents/projetos/$(projetoId)).data.consultorIds &&
            get(/databases/$(database)/documents/projetos/$(projetoId)).data.get('status', 'ativo') != 'finalizado');
        allow update, delete: if false;
      }
    }

    // Fechamento mensal de horas (só administrador e financeiro): um documento por mês ("YYYY-MM"),
    // com a auditoria de cada mudança de status em "historico" (só criada, nunca editada/apagada).
    match /fechamentos/{mesAno} {
      allow read, create, update: if isAdmin() || isFinanceiro();
      allow delete: if false;

      match /historico/{historicoId} {
        allow read: if isAdmin() || isFinanceiro();
        allow create: if (isAdmin() || isFinanceiro()) && request.resource.data.usuarioId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // O que cada consultor tem a receber no mês (detalhe dos lançamentos). Administrador e financeiro: tudo.
    // O consultor terceiro lê SÓ o próprio item, depois de liberado, e só pode gravar a confirmação/contestação dele.
    match /fechamentoItens/{itemId} {
      allow read: if isAdmin() || isFinanceiro() ||
        (isSignedIn() && meuRecursoId() != null && resource.data.recursoId == meuRecursoId() && resource.data.liberado == true);
      allow create, delete: if isAdmin() || isFinanceiro();
      allow update: if isAdmin() || isFinanceiro() ||
        (isSignedIn() && meuRecursoId() != null && resource.data.recursoId == meuRecursoId() && resource.data.liberado == true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmacao']) &&
          request.resource.data.confirmacao.status in ['confirmado', 'contestado']);
    }

    // Confirmação da parceira: vale a de cada consultor (statusConsultores) ou, em documentos antigos, a do responsável.
    function consultoresConfirmaram(d) {
      return d.get('statusConsultores', null) != null
        ? d.statusConsultores.values().hasOnly(['confirmado'])
        : d.confirmacao.status == 'confirmado';
    }

    // Fechamento de cada empresa parceira no mês. Administrador/financeiro gerenciam tudo (inclusive validar
    // a nota fiscal e registrar pagamentos). O responsável da parceira (perfil "responsavel_parceira") só
    // enxerga o da própria empresa DEPOIS de liberado o faturamento e só pode: registrar a ciência e
    // confirmar/contestar (campos "ciencia" e "confirmacao") e, depois de confirmar, enviar a nota fiscal
    // (campos "nf" e "historicoNf"), enquanto ela não existir ou tiver sido rejeitada.
    match /fechamentoParceiros/{fpId} {
      allow read: if isAdmin() || isFinanceiro() ||
        (isSignedIn() && meuUsuario().perfil == 'responsavel_parceira' &&
          resource.data.parceiraId == meuUsuario().get('parceiraId', null) && resource.data.liberado == true);
      allow create, delete: if isAdmin() || isFinanceiro();
      allow update: if isAdmin() || isFinanceiro() ||
        // O consultor terceiro só troca a PRÓPRIA chave em statusConsultores, enquanto a NF não foi enviada.
        (isSignedIn() && meuRecursoId() != null && resource.data.liberado == true &&
          resource.data.get('nf', null) == null &&
          resource.data.get('statusConsultores', null) != null && meuRecursoId() in resource.data.statusConsultores.keys() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statusConsultores']) &&
          request.resource.data.statusConsultores.diff(resource.data.statusConsultores).affectedKeys().hasOnly([meuRecursoId()]) &&
          request.resource.data.statusConsultores[meuRecursoId()] in ['confirmado', 'contestado']) ||
        (isSignedIn() && meuUsuario().perfil == 'responsavel_parceira' &&
          resource.data.parceiraId == meuUsuario().get('parceiraId', null) &&
          resource.data.liberado == true &&
          (
            (resource.data.confirmacao.status in ['pendente', 'contestado'] &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ciencia', 'confirmacao']) &&
              request.resource.data.confirmacao.status in ['pendente', 'confirmado', 'contestado'] &&
              (request.resource.data.confirmacao.status == 'pendente' || request.resource.data.ciencia.em != null))
            ||
            (consultoresConfirmaram(resource.data) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nf', 'historicoNf']) &&
              request.resource.data.nf.status == 'enviada' &&
              (resource.data.get('nf', null) == null || resource.data.nf.status == 'rejeitada'))
          ));
    }

    // Arquivos do fechamento (NF em PDF, comprovantes e documentos complementares), guardados no próprio Firestore em
    // partes de até ~700 KB (sem Firebase Storage). tipo: 'nf' | 'comprovante' | 'anexo'.
    // - administrador/financeiro: tudo;
    // - responsável da parceira: lê os arquivos da própria empresa e cria apenas a NF (PDF) dela.
    match /arquivosFechamento/{arquivoId} {
      allow read: if isAdmin() || isFinanceiro() ||
        (isSignedIn() && meuUsuario().perfil == 'responsavel_parceira' &&
          resource.data.parceiraId != null &&
          resource.data.parceiraId == meuUsuario().get('parceiraId', null));
      allow create: if isAdmin() || isFinanceiro() ||
        (isSignedIn() && meuUsuario().perfil == 'responsavel_parceira' &&
          request.resource.data.parceiraId != null &&
          request.resource.data.parceiraId == meuUsuario().get('parceiraId', null) &&
          request.resource.data.tipo == 'nf' &&
          request.resource.data.tamanho <= 3145728);
      allow update, delete: if isAdmin() || isFinanceiro();

      match /partes/{parteId} {
        allow read: if isAdmin() || isFinanceiro() ||
          (isSignedIn() && meuUsuario().perfil == 'responsavel_parceira' &&
            get(/databases/$(database)/documents/arquivosFechamento/$(arquivoId)).data.parceiraId != null &&
            get(/databases/$(database)/documents/arquivosFechamento/$(arquivoId)).data.parceiraId == meuUsuario().get('parceiraId', null));
        allow create: if isAdmin() || isFinanceiro() ||
          (isSignedIn() && meuUsuario().perfil == 'responsavel_parceira' &&
            getAfter(/databases/$(database)/documents/arquivosFechamento/$(arquivoId)).data.parceiraId == meuUsuario().get('parceiraId', null) &&
            getAfter(/databases/$(database)/documents/arquivosFechamento/$(arquivoId)).data.tipo == 'nf');
        allow update, delete: if isAdmin() || isFinanceiro();
      }
    }

    // Calendário/apontamento unificados: cada consultor só enxerga e mexe nos
    // próprios eventos (onde recursoId é o recurso vinculado a ele); admin e
    // coordenador enxergam e gerenciam o calendário de todo mundo.
    match /eventosCalendario/{id} {
      // Além do próprio apontamento, um consultor também pode ler os apontamentos de outros
      // consultores DENTRO DE UM PROJETO em que ele esteja alocado — para ele enxergar o que já
      // foi feito no escopo e o percentual real do projeto, sem ver apontamentos de projetos
      // que não são dele. A visão de calendário pessoal continua restrita ao próprio recurso
      // porque a tela em si só busca os eventos do próprio consultor.
      allow read: if isAdmin() || isCoordenador() || isFinanceiro() ||
        (isSignedIn() && resource.data.recursoId == meuRecursoId()) ||
        (isSignedIn() &&
          meuRecursoId() in get(/databases/$(database)/documents/projetos/$(resource.data.projetoId)).data.get('consultorIds', []));
      // Consultor não pode criar apontamento em projeto com status "finalizado"
      // (admin/coordenador continuam podendo, mesmo com o projeto finalizado).
      // .get() com padrão 'ativo' evita erro em projetos antigos sem o campo status.
      allow create: if isAdmin() || isCoordenador() ||
        (isSignedIn() && request.resource.data.recursoId == meuRecursoId() &&
          get(/databases/$(database)/documents/projetos/$(request.resource.data.projetoId)).data.get('status', 'ativo') != 'finalizado');
      allow update, delete: if isAdmin() || isCoordenador() ||
        (isSignedIn() && resource.data.recursoId == meuRecursoId());
    }
  }
}
